{
  "workflows": [
    {
      "id": "wf-telegram-bot-responder",
      "name": "💬 2-Way Telegram Bot Listener → Parallel Web Check + Gemini AI Reply",
      "active": false,
      "createdAt": "2026-11-11T06:20:00.000Z",
      "updatedAt": "2026-11-11T10:13:54.884Z",
      "nodes": [
        {
          "id": "tb-trig",
          "type": "telegram_trigger",
          "name": "On Telegram Message",
          "position": {
            "x": 70,
            "y": 230
          },
          "params": {
            "commandFilter": ""
          }
        },
        {
          "id": "tb-ai",
          "type": "gemini",
          "name": "Gemini AI Responder",
          "position": {
            "x": 380,
            "y": 230
          },
          "params": {
            "apiKey": "{{ $secrets.GEMINI_API_KEY }}",
            "model": "gemini-2.5-flash",
            "system": "You are Sriram's FlowForge Telegram Assistant. Reply concisely in friendly Tanglish.",
            "prompt": "User {{ $json.fromName || 'Sriram' }} sent on Telegram: {{ $json.text }}",
            "jsonMode": false
          }
        },
        {
          "id": "tb-reply",
          "type": "telegram",
          "name": "Reply in Telegram",
          "position": {
            "x": 690,
            "y": 148
          },
          "params": {
            "botToken": "{{ $secrets.TELEGRAM_BOT_TOKEN }}",
            "chatId": "{{ $json.chatId || $secrets.TELEGRAM_CHAT_ID }}",
            "text": "🤖 FlowForge AI:\n\n{{ $json.text }}",
            "parseMode": ""
          }
        },
        {
          "id": "tb-db",
          "type": "db_query",
          "name": "Log Chat to DB",
          "position": {
            "x": 690,
            "y": 313
          },
          "params": {
            "operation": "insert",
            "table": "ai_logs",
            "record": "{\n  \"channel\": \"telegram\",\n  \"reply\": \"{{ $json.text }}\"\n}",
            "limit": 25
          }
        }
      ],
      "edges": [
        {
          "id": "tbe1",
          "source": "tb-trig",
          "target": "tb-ai",
          "sourceHandle": "main"
        },
        {
          "id": "tbe2",
          "source": "tb-ai",
          "target": "tb-reply",
          "sourceHandle": "main"
        },
        {
          "id": "tbe3",
          "source": "tb-ai",
          "target": "tb-db",
          "sourceHandle": "main"
        },
        {
          "id": "e-6db96f9f",
          "source": "tb-trig",
          "target": "tb-ai",
          "sourceHandle": "main"
        }
      ]
    },
    {
      "id": "wf-parallel-multi-website",
      "name": "🌐 Parallel 5-Website Live Monitor → DB + Gemini AI + Telegram + Gmail",
      "active": false,
      "createdAt": "2026-11-11T06:25:00.000Z",
      "updatedAt": "2026-11-11T10:13:57.634Z",
      "nodes": [
        {
          "id": "pw-trigger",
          "type": "manual_trigger",
          "name": "Start Parallel Audit",
          "position": {
            "x": 60,
            "y": 220
          },
          "params": {
            "sample": "{\n  \"batchName\": \"Multi-Site Health & Content Audit\",\n  \"initiatedBy\": \"Sriram\"\n}"
          }
        },
        {
          "id": "pw-web",
          "type": "parallel_web",
          "name": "Parallel 5 Websites (Promise.all)",
          "position": {
            "x": 340,
            "y": 220
          },
          "params": {
            "urls": "https://news.ycombinator.com\nhttps://example.com\nhttps://jsonplaceholder.typicode.com/posts/1\nhttps://httpbin.org/get\nhttps://api.github.com/zen",
            "extract": "auto",
            "regex": "<title>([^<]+)</title>",
            "concurrency": 10,
            "emitMode": "summary_and_items"
          }
        },
        {
          "id": "pw-db",
          "type": "db_query",
          "name": "Save Audit to DB (Parallel 1)",
          "position": {
            "x": 660,
            "y": 60
          },
          "params": {
            "operation": "insert",
            "table": "website_monitors",
            "record": "{\n  \"totalSites\": \"{{ $json.totalSites }}\",\n  \"healthyCount\": \"{{ $json.healthyCount }}\",\n  \"avgLatencyMs\": \"{{ $json.avgLatencyMs }}\",\n  \"parallelWallTimeMs\": \"{{ $json.parallelWallTimeMs }}\",\n  \"summary\": \"{{ $json.summaryText }}\"\n}",
            "limit": 25
          }
        },
        {
          "id": "pw-ai",
          "type": "gemini",
          "name": "Gemini AI Analysis (Parallel 2)",
          "position": {
            "x": 660,
            "y": 230
          },
          "params": {
            "apiKey": "{{ $secrets.GEMINI_API_KEY }}",
            "model": "gemini-2.5-flash",
            "system": "Analyze parallel website check results and write a concise Tanglish status report.",
            "prompt": "Parallel audit completed in {{ $json.parallelWallTimeMs }}ms for {{ $json.totalSites }} websites ({{ $json.healthyCount }} UP). Details: {{ $json.summaryText }}",
            "jsonMode": false
          }
        },
        {
          "id": "pw-file",
          "type": "write_file",
          "name": "Write Audit Log (Parallel 3)",
          "position": {
            "x": 660,
            "y": 400
          },
          "params": {
            "path": "./data/files/parallel-websites.jsonl",
            "content": "{{ JSON.stringify($json) }}",
            "append": true
          }
        },
        {
          "id": "pw-tg",
          "type": "telegram",
          "name": "Telegram Live Alert (Parallel A)",
          "position": {
            "x": 980,
            "y": 140
          },
          "params": {
            "botToken": "{{ $secrets.TELEGRAM_BOT_TOKEN }}",
            "chatId": "{{ $secrets.TELEGRAM_CHAT_ID }}",
            "text": "🌐 Parallel Multi-Website Report:\n\n{{ $json.text }}",
            "parseMode": ""
          }
        },
        {
          "id": "pw-gmail",
          "type": "email",
          "name": "Gmail Live Report (Parallel B)",
          "position": {
            "x": 980,
            "y": 310
          },
          "params": {
            "provider": "gmail_smtp",
            "host": "smtp.gmail.com",
            "port": 465,
            "user": "{{ $secrets.GMAIL_USER }}",
            "pass": "{{ $secrets.GMAIL_APP_PASSWORD }}",
            "resendApiKey": "{{ $secrets.RESEND_API_KEY }}",
            "from": "{{ $secrets.DEFAULT_FROM_EMAIL }}",
            "to": "{{ $secrets.GMAIL_USER }}",
            "subject": "🌐 Parallel Multi-Website Audit Completed",
            "body": "Hi Sriram,\n\n5 websites were checked in parallel:\n\n{{ $json.text }}",
            "html": false
          }
        }
      ],
      "edges": [
        {
          "id": "pwe1",
          "source": "pw-trigger",
          "target": "pw-web",
          "sourceHandle": "main"
        },
        {
          "id": "pwe2",
          "source": "pw-web",
          "target": "pw-db",
          "sourceHandle": "main"
        },
        {
          "id": "pwe3",
          "source": "pw-web",
          "target": "pw-ai",
          "sourceHandle": "main"
        },
        {
          "id": "pwe4",
          "source": "pw-web",
          "target": "pw-file",
          "sourceHandle": "main"
        },
        {
          "id": "pwe5",
          "source": "pw-ai",
          "target": "pw-tg",
          "sourceHandle": "main"
        },
        {
          "id": "pwe6",
          "source": "pw-ai",
          "target": "pw-gmail",
          "sourceHandle": "main"
        }
      ]
    },
    {
      "id": "wf-live-ai-telegram-gmail",
      "name": "⚡ Live: Gemini AI → Telegram Bot + Gmail Dispatch (Active Keys)",
      "active": false,
      "createdAt": "2026-11-11T06:00:00.000Z",
      "updatedAt": "2026-11-11T10:14:00.700Z",
      "nodes": [
        {
          "id": "l-trigger",
          "type": "manual_trigger",
          "name": "Manual Trigger",
          "position": {
            "x": 60,
            "y": 200
          },
          "params": {
            "sample": "{\n  \"topic\": \"AI Workflow Automation in 2026\",\n  \"user\": \"Sriram\"\n}"
          }
        },
        {
          "id": "l-gemini",
          "type": "gemini",
          "name": "Gemini 2.5 Flash",
          "position": {
            "x": 340,
            "y": 200
          },
          "params": {
            "apiKey": "{{ $secrets.GEMINI_API_KEY }}",
            "model": "gemini-2.5-flash",
            "system": "Write a short, energetic 3-bullet update in Tanglish.",
            "prompt": "Hi! Give a 3-bullet update for {{ $json.user }} about: {{ $json.topic }}",
            "jsonMode": false
          }
        },
        {
          "id": "l-tg",
          "type": "telegram",
          "name": "Telegram Alert (@Bot)",
          "position": {
            "x": 650,
            "y": 100
          },
          "params": {
            "botToken": "{{ $secrets.TELEGRAM_BOT_TOKEN }}",
            "chatId": "{{ $secrets.TELEGRAM_CHAT_ID }}",
            "text": "🚀 FlowForge Live Run!\n\n{{ $json.text }}",
            "parseMode": ""
          }
        },
        {
          "id": "l-gmail",
          "type": "email",
          "name": "Send Gmail Alert",
          "position": {
            "x": 650,
            "y": 300
          },
          "params": {
            "provider": "gmail_smtp",
            "host": "smtp.gmail.com",
            "port": 465,
            "user": "{{ $secrets.GMAIL_USER }}",
            "pass": "{{ $secrets.GMAIL_APP_PASSWORD }}",
            "resendApiKey": "{{ $secrets.RESEND_API_KEY }}",
            "from": "{{ $secrets.DEFAULT_FROM_EMAIL }}",
            "to": "{{ $secrets.GMAIL_USER }}",
            "subject": "⚡ FlowForge Live AI Automation Report",
            "body": "Hi Sriram,\n\nHere is your live Gemini AI output from FlowForge:\n\n{{ $json.text }}",
            "html": false
          }
        }
      ],
      "edges": [
        {
          "id": "le1",
          "source": "l-trigger",
          "target": "l-gemini",
          "sourceHandle": "main"
        },
        {
          "id": "le2",
          "source": "l-gemini",
          "target": "l-tg",
          "sourceHandle": "main"
        },
        {
          "id": "le3",
          "source": "l-gemini",
          "target": "l-gmail",
          "sourceHandle": "main"
        }
      ]
    },
    {
      "id": "wf-demo-api-pipeline",
      "name": "🚀 Live Demo: API Fetch → IF Filter → JS Transform → File Log",
      "active": false,
      "createdAt": "2026-11-11T05:30:00.000Z",
      "updatedAt": "2026-11-11T05:30:00.000Z",
      "nodes": [
        {
          "id": "n-trigger",
          "type": "manual_trigger",
          "name": "Manual Trigger",
          "position": {
            "x": 60,
            "y": 200
          },
          "params": {
            "sample": "{\n  \"requestedBy\": \"Sriram\",\n  \"env\": \"local\"\n}"
          }
        },
        {
          "id": "n-http",
          "type": "http_request",
          "name": "Fetch Users API",
          "position": {
            "x": 330,
            "y": 200
          },
          "params": {
            "method": "GET",
            "url": "https://jsonplaceholder.typicode.com/users",
            "headers": "{}",
            "body": ""
          }
        },
        {
          "id": "n-if",
          "type": "if",
          "name": "Check User ID <= 3",
          "position": {
            "x": 600,
            "y": 200
          },
          "params": {
            "left": "{{ $json.id }}",
            "operator": "lt",
            "right": "4"
          }
        },
        {
          "id": "n-code",
          "type": "code",
          "name": "Enrich Top Users",
          "position": {
            "x": 880,
            "y": 120
          },
          "params": {
            "code": "return items.map(i => ({\n  id: i.json.id,\n  name: i.json.name,\n  email: i.json.email,\n  company: i.json.company?.name,\n  summary: `${i.json.name} <${i.json.email}> @ ${i.json.company?.name}`,\n  processedAt: new Date().toISOString()\n}));"
          }
        },
        {
          "id": "n-write",
          "type": "write_file",
          "name": "Save Top Users Log",
          "position": {
            "x": 1160,
            "y": 120
          },
          "params": {
            "path": "./data/files/top-users.jsonl",
            "content": "{{ JSON.stringify($json) }}",
            "append": true
          }
        }
      ],
      "edges": [
        {
          "id": "e1",
          "source": "n-trigger",
          "target": "n-http"
        },
        {
          "id": "e2",
          "source": "n-http",
          "target": "n-if"
        },
        {
          "id": "e3",
          "source": "n-if",
          "sourceHandle": "true",
          "target": "n-code"
        },
        {
          "id": "e4",
          "source": "n-code",
          "target": "n-write"
        }
      ]
    },
    {
      "id": "wf-payment-whatsapp",
      "name": "💳 Razorpay Webhook → Verify → WhatsApp + Google Sheets",
      "active": false,
      "createdAt": "2026-11-11T05:31:00.000Z",
      "updatedAt": "2026-11-11T10:14:06.116Z",
      "nodes": [
        {
          "id": "p-hook",
          "type": "webhook_trigger",
          "name": "Razorpay Webhook",
          "position": {
            "x": 60,
            "y": 200
          },
          "params": {
            "path": "razorpay-order",
            "method": "POST",
            "respond": "lastNode"
          }
        },
        {
          "id": "p-set",
          "type": "set",
          "name": "Normalize Order Data",
          "position": {
            "x": 340,
            "y": 200
          },
          "params": {
            "values": "{\n  \"orderId\": \"{{ $json.body?.orderId || 'ORD-' + Date.now() }}\",\n  \"customer\": \"{{ $json.body?.name || 'Customer' }}\",\n  \"amountInr\": \"{{ $json.body?.amount || 499 }}\",\n  \"phone\": \"{{ $json.body?.phone || '919876543210' }}\",\n  \"status\": \"CONFIRMED\"\n}",
            "keepExisting": false
          }
        },
        {
          "id": "p-wa",
          "type": "whatsapp",
          "name": "WhatsApp Confirmation",
          "position": {
            "x": 640,
            "y": 100
          },
          "params": {
            "token": "{{ $secrets.WHATSAPP_TOKEN }}",
            "phoneNumberId": "{{ $secrets.WHATSAPP_PHONE_ID }}",
            "to": "{{ $json.phone }}",
            "kind": "text",
            "text": "Hi {{ $json.customer }}! Your payment of ₹{{ $json.amountInr }} for {{ $json.orderId }} is confirmed 🎉",
            "template": "hello_world",
            "language": "en_US"
          }
        },
        {
          "id": "p-sheet",
          "type": "google_sheets",
          "name": "Append to Orders Sheet",
          "position": {
            "x": 640,
            "y": 300
          },
          "params": {
            "credentials": "{{ $secrets.GOOGLE_SERVICE_ACCOUNT }}",
            "operation": "append",
            "spreadsheetId": "your-spreadsheet-id",
            "range": "Orders!A:E",
            "values": "[\"{{ $json.orderId }}\", \"{{ $json.customer }}\", \"{{ $json.amountInr }}\", \"{{ $json.phone }}\", \"{{ $today }}\"]"
          }
        }
      ],
      "edges": [
        {
          "id": "pe1",
          "source": "p-hook",
          "target": "p-set",
          "sourceHandle": "main"
        },
        {
          "id": "pe2",
          "source": "p-set",
          "target": "p-wa",
          "sourceHandle": "main"
        },
        {
          "id": "pe3",
          "source": "p-set",
          "target": "p-sheet",
          "sourceHandle": "main"
        }
      ]
    },
    {
      "id": "wf-ai-digest",
      "name": "🤖 Scheduled AI Digest: Cron → HTTP → Gemini AI → Telegram & Slack",
      "active": false,
      "createdAt": "2026-11-11T05:32:00.000Z",
      "updatedAt": "2026-11-11T05:32:00.000Z",
      "nodes": [
        {
          "id": "a-cron",
          "type": "schedule_trigger",
          "name": "Every Morning 9 AM",
          "position": {
            "x": 60,
            "y": 200
          },
          "params": {
            "cron": "0 9 * * *",
            "timezone": "Asia/Kolkata"
          }
        },
        {
          "id": "a-http",
          "type": "http_request",
          "name": "Fetch HackerNews Top",
          "position": {
            "x": 330,
            "y": 200
          },
          "params": {
            "method": "GET",
            "url": "https://hn.algolia.com/api/v1/search?tags=front_page&hitsPerPage=5",
            "headers": "{}",
            "body": ""
          }
        },
        {
          "id": "a-gemini",
          "type": "gemini",
          "name": "Gemini Summarize",
          "position": {
            "x": 600,
            "y": 200
          },
          "params": {
            "apiKey": "{{ $secrets.GEMINI_API_KEY }}",
            "model": "gemini-2.5-flash",
            "system": "Summarize top tech stories in crisp Tanglish bullet points.",
            "prompt": "Summarize these stories: {{ JSON.stringify($json.hits?.map(h => h.title)) }}",
            "jsonMode": false
          }
        },
        {
          "id": "a-tg",
          "type": "telegram",
          "name": "Send to Telegram",
          "position": {
            "x": 880,
            "y": 120
          },
          "params": {
            "botToken": "{{ $secrets.TELEGRAM_BOT_TOKEN }}",
            "chatId": "{{ $secrets.TELEGRAM_CHAT_ID }}",
            "text": "🌅 Morning AI Digest:\n\n{{ $json.text }}",
            "parseMode": ""
          }
        },
        {
          "id": "a-slack",
          "type": "slack",
          "name": "Post to Slack",
          "position": {
            "x": 880,
            "y": 290
          },
          "params": {
            "webhookUrl": "{{ $secrets.SLACK_WEBHOOK_URL }}",
            "text": "🌅 *Morning AI Digest*\n{{ $json.text }}"
          }
        }
      ],
      "edges": [
        {
          "id": "ae1",
          "source": "a-cron",
          "target": "a-http"
        },
        {
          "id": "ae2",
          "source": "a-http",
          "target": "a-gemini"
        },
        {
          "id": "ae3",
          "source": "a-gemini",
          "target": "a-tg"
        },
        {
          "id": "ae4",
          "source": "a-gemini",
          "target": "a-slack"
        }
      ]
    }
  ],
